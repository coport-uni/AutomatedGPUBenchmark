# Keep LF in the repository and in Windows checkouts for files that
# are executed inside Linux containers or by Git Bash hooks.
* text=auto
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
Dockerfile text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.jsonl text eol=lf
